generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  passwordHash String?
  role         String        @default("docente") // docente | admin
  createdAt    DateTime      @default(now())
  orders       Order[]
  entitlements Entitlement[]
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  status    OrderStatus @default(pending)
  mpOrderId String?
  totalMXN  Int
  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id])
  itemId   String
  priceMXN Int

  // Presentes solo para compras del catálogo real (via /api/checkout); los 3
  // productos de prueba (via /api/orders) los dejan null y siguen usando
  // solo itemId, como hasta ahora.
  grado           Int?
  ruta            String? // BASE | VISUAL | SEGUIMIENTO | INTEGRAL
  cobertura       String? // quincena | mes | trimestre | ciclo
  periodoComprado String? // codigo segun cobertura: T1_Q01 | T1_M01 | T1 | CICLO

  // Solo para compras en modo "producción" via /api/checkout/link (enlace
  // fijo de Mercado Pago, sin tokenizar tarjeta): el codigo de la matriz de
  // 16 enlaces (QB..CI) que se cobró.
  paymentCode String?
}

model Entitlement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  itemId    String
  orderId   String
  createdAt DateTime @default(now())

  // Copiados de OrderItem al momento de otorgar el entitlement (solo para
  // compras del catalogo real via /api/checkout) -- el "motor de reglas"
  // los usa para decidir que archivos desbloquea esta compra.
  grado           Int?
  ruta            String?
  cobertura       String?
  periodoComprado String?

  @@unique([userId, itemId])
}

enum OrderStatus {
  pending
  approved
  rejected
  cancelled
}

// Mirror casi literal de la hoja 05_Matriz_Web del Directorio de
// Publicaciones (fuente de la verdad del negocio): una fila = grado + ruta +
// bloque de publicacion. Los nombres *Archivo son los que documenta esa
// hoja - no siempre calzan con el nombre real del archivo en disco (ver
// scripts/audit-archivos.ts), por eso el archivo fisico se resuelve por
// separado en ArchivoDrive.
model Publicacion {
  id               String   @id @default(cuid())
  grado            Int
  ruta             String // BASE | VISUAL | SEGUIMIENTO | INTEGRAL
  periodo          String // T1_Q01 ... CA
  publicarEl       DateTime
  implementaInicio DateTime
  implementaFin    DateTime
  trimestre        String // T1 | T2 | T3 | CA
  mesComercial     String // T1_M01 ... | CA
  compraQuincena   String
  compraMes        String
  compraTrimestre  String
  compraCiclo      String // "CICLO"

  planeacionArchivo           String?
  fichasArchivo                String?
  diapositivaS01Archivo       String?
  diapositivaS02Archivo       String?
  diapositivaS03Archivo       String?
  seguimientoQuincenaArchivo  String?
  seguimientoMesArchivo       String?
  seguimientoTrimestreArchivo String?
  seguimientoCicloArchivo     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([grado, ruta, periodo])
}

// Un archivo fisico real, deduplicado por nombre real (no por el nombre que
// documenta la matriz). Varias filas de Publicacion pueden apuntar al mismo
// nombreArchivo (ej. Planeacion/Fichas/Diapositivas no dependen de la ruta).
model ArchivoDrive {
  id            String    @id @default(cuid())
  nombreArchivo String    @unique
  tipo          String // planeacion | fichas | diapositiva | seguimiento
  label         String? // nombre del recurso editable a mano (si no, se calcula del periodo)
  path          String? // ruta dentro del volumen de Railway una vez subido
  sizeBytes     Int?
  ingestedAt    DateTime?
  createdAt     DateTime  @default(now())

  // Solo para filas agregadas a mano desde el panel admin (no vienen de la
  // matriz semillada) -- necesitan su propia ubicacion en el arbol porque no
  // hay ninguna fila de Publicacion que las referencie.
  manual    Boolean @default(false)
  grado     Int?
  trimestre String?
}

// Ajustes globales del sitio -- fila unica ("global"). Por ahora solo
// controla si /planes cobra con el checkout dinamico de tarjeta (modo de
// pruebas) o redirige a los 16 enlaces fijos de Mercado Pago (produccion).
model AppSettings {
  id        String   @id @default("global")
  modoPago  String   @default("prueba") // prueba | produccion
  updatedAt DateTime @updatedAt
}

// Matriz oficial de los 16 enlaces fijos de Mercado Pago: cobertura + ruta
// (modalidad) determinan el codigo, precio y URL -- el grado NO es parte de
// la llave, un mismo codigo cubre los 6 grados (Especificacion de Enlaces
// de Pago e Integracion Web v1.0). Precio y URL son editables desde el
// panel admin, no deben quedar fijos en el codigo.
model PaymentProduct {
  id        String   @id @default(cuid())
  codigo    String   @unique // QB | QV | QS | QI | MB | MV | MS | MI | TB | TV | TS | TI | CB | CV | CS | CI
  cobertura String // quincena | mes | trimestre | ciclo
  ruta      String // BASE | VISUAL | SEGUIMIENTO | INTEGRAL
  precioMXN Int
  url       String
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}
